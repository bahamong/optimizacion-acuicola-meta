# Configuración del backend — copia este archivo a `.env` para personalizar.
# Todos los valores son OPCIONALES: si no defines un .env, se usan estos por defecto.

# ── Servidor ──────────────────────────────────────────────
DEBUG=True
HOST=127.0.0.1
PORT=8000

# ── Base de datos ─────────────────────────────────────────
DATABASE_URL=sqlite:///./acuicola.db

# ── Algoritmo Genético ────────────────────────────────────
AG_POBLACION=60
AG_GENERACIONES=150
AG_TASA_MUTACION=0.05
AG_TASA_CRUZAMIENTO=0.85

# ── Método del Gradiente ──────────────────────────────────
GRAD_TOLERANCIA=1e-6
GRAD_ITERACIONES=300

# ── Penalizaciones ────────────────────────────────────────
PENALIZACION_INCUMPLIMIENTO=1000.0
PENALIZACION_CALIDAD=500.0
PENALIZACION_CAPACIDAD=300.0

# ── Parámetros de negocio ─────────────────────────────────
PRECIO_VENTA_TON=250.0
COSTO_ALMACENAMIENTO=2.0
